# 서울 열린데이터 광장 인증키 (https://data.seoul.go.kr/)
# 아래 파일을 복사해 .env 로 만든 뒤 실제 키를 입력하세요.
#   cp .env.example .env
SEOUL_API_KEY=YOUR_ACCESS_KEY_HERE

# (선택) 수집 기본 상한. 0 또는 비우면 전체 수집.
COLLECT_LIMIT=20000

# (선택) 기준 년분기 코드. 예: 20261 = 2026년 1분기. 비우면 전체 분기 수집.
# 설정 시 해당 분기만 서버에서 필터링해 받아온다(신규 데이터 위주 수집).
TARGET_QUARTER=
